---
import Base from '../layouts/Base.astro';
import { route } from '../i18n';
---
<Base lang="es" alt="/en" title="404">
  <div class="stack" style="gap:28px">
    <section class="term">
      <div class="term__bar"><i></i><i></i><i></i><span>~/franklin — zsh</span></div>
      <div class="notfound">
        <div class="prompt"><b>$</b>&nbsp;cd&nbsp;<span id="missing-path">/ruta</span></div>
        <p class="notfound__err">zsh: no such file or directory</p>
        <h1>404</h1>
        <p class="notfound__msg">Esta página no existe o se movió.</p>
        <p class="notfound__msg notfound__msg--en">This page doesn't exist or has moved.</p>
        <div class="actions">
          <a class="btn btn--primary" href={route('es', 'home')}>cd ~/inicio</a>
          <a class="btn btn--ghost" href={route('en', 'home')}>cd ~/home (EN)</a>
          <a class="btn btn--ghost" href={route('es', 'blog')}>/blog</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const el = document.getElementById('missing-path');
  if (el) {
    try {
      el.textContent = decodeURIComponent(location.pathname);
    } catch {
      el.textContent = location.pathname;
    }
  }
</script>
